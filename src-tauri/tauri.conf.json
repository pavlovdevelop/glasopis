{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glasopis",
  "version": "0.1.0",
  "identifier": "com.glasopis.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Pavel Pavlov",
    "copyright": "Copyright (c) 2026 Pavel Pavlov",
    "category": "Productivity",
    "shortDescription": "Говориш. То пише.",
    "longDescription": "Безплатно гласово въвеждане на български език за Windows. Говорете и Glasopis въвежда текста в активното приложение. Разпознаването на реч е локално — гласът не напуска компютъра ви.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Bulgarian", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
